# api-gateway. Never point this at a service port directly — the gateway is what
# rate-limits and rejects revoked tokens.
GATEWAY_URL=http://localhost:8080

# true  → render from lib/mock/* , no backend needed, no login required
# false → live: needs `make infra-up`, `make run-gateway`, `make run-admin`,
#         `make run-analytics`, and an account with role ADMIN
ADMIN_USE_MOCK=true

# true only behind a proxy that OVERWRITES X-Forwarded-For. Then the sign-in and
# password-reset routes relay it, so auth-service logs the admin's own address.
# Left false, a caller could set the header and dodge the gateway's per-IP limit.
ADMIN_TRUST_PROXY=false

NEXT_PUBLIC_TURNSTILE_SITE_KEY=